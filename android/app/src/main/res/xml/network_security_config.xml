<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认禁止 cleartext -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 允许酷狗域名 cleartext（MV / 音频 HTTP 流） -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- *.kugou.com 一级子域 -->
        <domain includeSubdomains="true">kugou.com</domain>
        <!-- 二级子域：*.tx.kugou.com / *.mobile.kugou.com 等不被上一条覆盖 -->
        <domain includeSubdomains="true">tx.kugou.com</domain>
        <domain includeSubdomains="true">mobile.kugou.com</domain>
        <domain includeSubdomains="true">service.kugou.com</domain>
        <domain includeSubdomains="true">fsandroid.kugou.com</domain>
        <domain includeSubdomains="true">fsmvpc.kugou.com</domain>
        <domain includeSubdomains="true">fsmvpc.tx.kugou.com</domain>
        <domain includeSubdomains="true">fsandroid.tx.kugou.com</domain>
        <domain includeSubdomains="true">kugouaudio.com</domain>
    </domain-config>
</network-security-config>
